# SevaSetu (सेवासेतु) — Environment Configuration
# Copy this file to .env.local to configure live providers.
# If left empty, SevaSetu automatically uses built-in resilient demo fallbacks.

# Option 1: Google AI Studio API (Gemma 4 / Gemini Multimodal)
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 2: Local Ollama / OpenAI-Compatible Endpoint (Optional alternative)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:12b

# Optional: Custom SQLite file path (defaults to ./data/sevasetu.db)
SEVASETU_DB_PATH=
