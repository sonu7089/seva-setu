# SevaSetu (सेवासेतु) — Environment Configuration
# Copy this file to .env.local to configure live providers.
# If left empty, SevaSetu automatically uses built-in resilient demo fallbacks.
#
# Provider fallback chain (first configured wins, failures fall through):
#   DigitalOcean Gradient AI → Google AI Studio → Local Ollama → Offline Fallback

# Option 1 (Phase 6): DigitalOcean Gradient™ AI — Serverless Inference
# Model Access Key from the DO console (Gradient AI → Model Access Keys).
# Verified Gemma 4 model: gemma-4-31B-it (text + image, ~$0.18/$0.50 per 1M tokens)
DO_MODEL_ACCESS_KEY=
DO_INFERENCE_MODEL=gemma-4-31B-it
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# Optional: Gradient Agent endpoint, e.g. https://<agent>.agents.do-ai.run
DO_GENAI_ENDPOINT=
DO_GENAI_API_KEY=
# Optional: self-hosted Gemma 4 on a GPU Droplet (OpenAI-compatible endpoint)
DO_GPU_DROPLET_URL=
DO_GPU_MODEL=gemma3:12b

# Option 2: Google AI Studio API (Gemma 4 / Gemini Multimodal)
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 3: Local Ollama / OpenAI-Compatible Endpoint (Optional alternative)
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:12b

# Optional: Custom SQLite file path (defaults to ./data/sevasetu.db)
SEVASETU_DB_PATH=
